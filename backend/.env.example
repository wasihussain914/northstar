# Copy to .env and fill in one key, or both.
# This computer's LAN IPv4, for phones/tablets on the same Wi-Fi.
# Leave unset so teammates keep talking to localhost only.
# LOCAL_IP=192.168.1.42
# FRONTEND_PORT=5173
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Gemini (Google AI / Gemini Developer API): https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# If both keys are set, Claude is used unless you select Gemini:
# NORTHSTAR_PROVIDER=gemini
# NORTHSTAR_GEMINI_MODEL=gemini-3.8-flash
# Save each board snapshot and the model's reading to backend/debug/
# NORTHSTAR_DEBUG=1

# Optional: a neural GPS voice (ElevenLabs). Without it the browser speaks.
# ELEVENLABS_API_KEY=
